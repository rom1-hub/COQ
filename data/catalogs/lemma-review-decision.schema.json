{
  "$defs": {
    "CandidateAuditFlag": {
      "enum": [
        "first_group_suggestion_not_er",
        "second_group_suggestion_not_ir",
        "third_group_suffix_mismatch",
        "ending_not_in_er_ir_re_oir",
        "hyphenated_token_needs_lemma_review",
        "multiword_token_needs_lemma_review",
        "apostrophe_token_needs_lemma_review",
        "non_letter_symbol_needs_lemma_review",
        "multiple_group_suggestions"
      ],
      "title": "CandidateAuditFlag",
      "type": "string"
    },
    "DecisionEvidence": {
      "additionalProperties": false,
      "description": "Traceable source claim used to support a lexical review decision.",
      "properties": {
        "evidence_id": {
          "pattern": "^EVD-[A-Z0-9-]{2,40}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_kind": {
          "enum": [
            "official_conjugation_table",
            "official_dictionary_entry",
            "third_party_lexicon"
          ],
          "title": "Evidence Kind",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "supports": {
          "maxLength": 700,
          "minLength": 10,
          "title": "Supports",
          "type": "string"
        },
        "consulted_on": {
          "format": "date",
          "title": "Consulted On",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "evidence_kind",
        "source_url",
        "supports",
        "consulted_on"
      ],
      "title": "DecisionEvidence",
      "type": "object"
    },
    "VerbGroup": {
      "enum": [
        "first",
        "second",
        "third"
      ],
      "title": "VerbGroup",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A schema-validated, human-authored lexical review decision.",
  "properties": {
    "schema_version": {
      "const": "1.3",
      "default": "1.3",
      "title": "Schema Version",
      "type": "string"
    },
    "decision_id": {
      "pattern": "^LR-[0-9]{3}$",
      "title": "Decision Id",
      "type": "string"
    },
    "decision_scope": {
      "default": "candidate",
      "enum": [
        "candidate",
        "editorial_observation"
      ],
      "title": "Decision Scope",
      "type": "string"
    },
    "decision_outcome": {
      "enum": [
        "lemma_metadata_reviewed",
        "source_token_not_canonical_lemma"
      ],
      "title": "Decision Outcome",
      "type": "string"
    },
    "source_candidate_id": {
      "anyOf": [
        {
          "pattern": "^cand_[0-9a-f]{16}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Candidate Id"
    },
    "source_candidate_form": {
      "maxLength": 100,
      "minLength": 2,
      "title": "Source Candidate Form",
      "type": "string"
    },
    "canonical_infinitive": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 2,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Infinitive"
    },
    "display_infinitive": {
      "anyOf": [
        {
          "maxLength": 110,
          "minLength": 2,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Display Infinitive"
    },
    "group_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerbGroup"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "construction_policy": {
      "anyOf": [
        {
          "enum": [
            "pronominal_only",
            "non_pronominal_only",
            "multiple_constructions"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Construction Policy"
    },
    "pronominal_marker": {
      "anyOf": [
        {
          "enum": [
            "se",
            "s'"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pronominal Marker"
    },
    "related_lemma": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 2,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Related Lemma"
    },
    "related_construction": {
      "anyOf": [
        {
          "maxLength": 120,
          "minLength": 2,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Related Construction"
    },
    "resolves_findings": {
      "items": {
        "$ref": "#/$defs/CandidateAuditFlag"
      },
      "title": "Resolves Findings",
      "type": "array"
    },
    "source_evidence": {
      "items": {
        "$ref": "#/$defs/DecisionEvidence"
      },
      "title": "Source Evidence",
      "type": "array"
    },
    "forms_review_status": {
      "default": "pending",
      "enum": [
        "pending",
        "not_applicable"
      ],
      "title": "Forms Review Status",
      "type": "string"
    },
    "decision_authority": {
      "const": "linguistic_owner",
      "default": "linguistic_owner",
      "title": "Decision Authority",
      "type": "string"
    },
    "decision_note": {
      "maxLength": 1500,
      "minLength": 10,
      "title": "Decision Note",
      "type": "string"
    },
    "approved_for_production": {
      "const": false,
      "default": false,
      "title": "Approved For Production",
      "type": "boolean"
    }
  },
  "required": [
    "decision_id",
    "decision_outcome",
    "source_candidate_form",
    "decision_note"
  ],
  "title": "LemmaReviewDecision",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
